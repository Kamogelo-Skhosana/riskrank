# OWASP ZAP connection
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=your-zap-api-key

# LLM provider for the triage layer
LLM_API_KEY=your-llm-api-key
LLM_MODEL=claude-sonnet-4-6

# Storage
DATABASE_URL=sqlite:///./riskrank.db

# Dashboard (Phase 3): `riskrank serve`
# 127.0.0.1 = only this computer can open it. The dashboard has no login yet,
# so only use 0.0.0.0 (all network interfaces) inside Docker or a trusted network.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
